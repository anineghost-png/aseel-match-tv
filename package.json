{
  "name": "aseel-match-tv",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24.0.0"
  },
  "scripts": {
    "build": "tsc",
    "start": "node --env-file-if-exists=.env dist/services/api/server.js",
    "dev": "npm run build && npm start",
    "test": "node --import tsx --test tests/*.test.ts",
    "test:browser": "playwright test",
    "check": "npm run build && npm test",
    "media": "node scripts/generate-test-media.mjs",
    "ps4": "node scripts/setup.mjs --lan && npm run build && npm run media && npm start",
    "ps4:dramalive": "node scripts/dramalive-ps4.mjs"
  },
  "dependencies": {
    "@fastify/rate-limit": "10.3.0",
    "@fastify/static": "10.1.7",
    "fastify": "5.12.7",
    "hls.js": "1.6.13",
    "saxes": "6.0.0",
    "zod": "4.6.7"
  },
  "devDependencies": {
    "@playwright/test": "1.56.1",
    "@types/node": "24.10.0",
    "acorn": "8.15.0",
    "prettier": "3.6.2",
    "tsx": "4.20.6",
    "typescript": "5.9.3"
  }
}
